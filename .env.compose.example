# Public port exposed by the frontend reverse proxy
HTTP_PORT=8080

# Set this to the exact public origin when deployed behind HTTPS.
FRONTEND_ORIGIN=http://localhost:8080

# Generate unique values before deploying:
# openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Optional Supabase Storage integration for the backend.
SUPABASE_URL=
SUPABASE_STORAGE_SECRET_KEY=

# Shared by BFF and backend for scheduled upload cleanup.
CRON_SECRET=
