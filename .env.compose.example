# Public port exposed by the frontend reverse proxy
HTTP_PORT=8080

# Set this to the exact public origin when deployed behind HTTPS.
FRONTEND_ORIGIN=http://localhost:8080

# Generate unique values before deploying:
# openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Required relational database and server-side Storage credentials.
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_project_key
SUPABASE_API_SECRET=replace_with_backend_api_secret
SUPABASE_STORAGE_SECRET_KEY=sb_secret_replace_with_storage_secret

# Shared by BFF and backend for scheduled upload cleanup.
CRON_SECRET=
