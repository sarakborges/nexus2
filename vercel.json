{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "front": {
      "root": "apps/front",
      "framework": "vite",
      "installCommand": "npm ci --no-audit --no-fund",
      "outputDirectory": "build",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "bff": {
      "root": "apps/bff",
      "framework": "nestjs",
      "entrypoint": "src/main.ts",
      "installCommand": "npm ci --no-audit --no-fund",
      "bindings": [
        {
          "type": "service",
          "service": "back",
          "format": "url",
          "env": "BACKEND_SERVICE_URL"
        }
      ]
    },
    "back": {
      "root": "apps/back",
      "framework": "nestjs",
      "entrypoint": "src/main.ts",
      "installCommand": "npm ci --no-audit --no-fund"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "bff"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "front"
      }
    }
  ]
}
