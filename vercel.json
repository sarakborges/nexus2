{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "front": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "apps/front/Dockerfile"
    },
    "bff": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "apps/bff/Dockerfile",
      "bindings": [
        {
          "type": "service",
          "service": "back",
          "format": "url",
          "env": "BACKEND_SERVICE_URL"
        }
      ]
    },
    "back": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "apps/back/Dockerfile"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "bff"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "front"
      }
    }
  ]
}
