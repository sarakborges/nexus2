BACK_PORT=3002
BFF_ORIGIN=http://localhost:3001
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Persistent storage through the private Nexus RPCs in Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_API_SECRET=

# Supabase server-side Secret API key used by Storage and the topic Realtime publisher. Never expose this to the frontend.
SUPABASE_STORAGE_SECRET_KEY=

# Shared with the BFF to protect the daily Vercel upload-cleanup cron.
CRON_SECRET=
